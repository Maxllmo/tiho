<Application x:Class="ProxyHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0B1220"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#121A2A"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#182234"/>
        <SolidColorBrush x:Key="BorderBrushKey" Color="#2A3A52"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E7EEF8"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A9BB5"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4BA3F5"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#3ECF8E"/>
        <SolidColorBrush x:Key="RedBrush" Color="#F0617D"/>
        <SolidColorBrush x:Key="AmberBrush" Color="#F0B429"/>
    </Application.Resources>
</Application>
