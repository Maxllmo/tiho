<Window x:Class="ProxyHub.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Tiho" Width="900" Height="720" MinWidth="740" MinHeight="660" WindowStartupLocation="CenterScreen"
 Icon="Assets/app.ico" Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged">
 <Grid Margin="28,22,28,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,22">
   <StackPanel Orientation="Horizontal"><Image Source="Assets/logo-mark.png" Width="34" Height="34" Margin="0,0,10,0"/><TextBlock Text="Tiho" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <TextBlock Text="VPN для всего компьютера" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
  </DockPanel>
  <TabControl x:Name="Tabs" Grid.Row="1" BorderThickness="0" Background="Transparent">
   <TabControl.Resources>
    <Style TargetType="TabItem">
     <Setter Property="Padding" Value="18,11"/><Setter Property="Foreground" Value="#777D89"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
      <Border x:Name="Tab" Padding="{TemplateBinding Padding}" Margin="0,0,8,16" CornerRadius="6" Background="Transparent">
       <ContentPresenter ContentSource="Header"/>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="White"/><Setter Property="Foreground" Value="#191C23"/></Trigger></ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value></Setter>
    </Style>
   </TabControl.Resources>
   <TabItem Header="Подключение">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <Border Style="{StaticResource Card}">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
         <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#A2A7B2" Margin="0,0,9,0"/><TextBlock x:Name="LblStatus" Text="Отключено" FontSize="23" FontWeight="SemiBold"/></StackPanel>
         <TextBlock x:Name="LblServer" Text="Добавьте конфигурацию AmneziaWG в настройках" Foreground="#777D89" Margin="18,9,12,0" TextWrapping="Wrap"/>
         <TextBlock x:Name="LblRoute" Text="Весь ПК · Россия напрямую" Style="{StaticResource Muted}" Margin="18,7,0,0"/>
        </StackPanel>
        <Button x:Name="BtnConnect" Grid.Column="1" Content="Подключить" Style="{StaticResource Primary}" Width="155" Height="46" VerticalAlignment="Center" Click="BtnConnect_Click"/>
       </Grid>
      </Border>
      <Border x:Name="Notice" Background="#FFF3D8" CornerRadius="6" Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed"><TextBlock x:Name="LblNotice" TextWrapping="Wrap" Foreground="#80600E"/></Border>
      <UniformGrid Columns="4" Margin="0,16,0,0">
       <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,6,0"><StackPanel><TextBlock Text="Время подключения" Style="{StaticResource Label}"/><TextBlock x:Name="LblDuration" Text="00:00:00" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="LblTotalDuration" Text="Всего 00:00:00" Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Padding="16" Margin="5,0,5,0"><StackPanel><TextBlock Text="Скорость, Мбит/с" Style="{StaticResource Label}"/><TextBlock x:Name="LblDownload" Text="↓ 0,0" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="LblUpload" Text="↑ 0,0 Мбит/с" Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Padding="16" Margin="5,0,5,0"><StackPanel><TextBlock Text="Пинг" Style="{StaticResource Label}"/><TextBlock x:Name="LblPing" Text="—" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Через сервер, HTTPS" Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Padding="16" Margin="6,0,0,0"><StackPanel><TextBlock Text="Трафик за сеанс" Style="{StaticResource Label}"/><TextBlock x:Name="LblTraffic" Text="0,00 ГБ" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="LblLifetime" Text="Всего 0,00 ГБ" Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></Border>
      </UniformGrid>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,17">
       <StackPanel>
        <DockPanel><TextBlock Text="Загрузка" FontWeight="SemiBold"/><TextBlock Text="Последние 60 секунд · Мбит/с" Style="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel>
        <Grid Height="106" Margin="0,14,0,8" ClipToBounds="True" SizeChanged="Chart_SizeChanged">
         <Border BorderBrush="#EDF0F3" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
         <Polyline x:Name="SpeedLine" Stroke="#21856B" StrokeThickness="2" StrokeLineJoin="Round"/>
        </Grid>
        <DockPanel><TextBlock x:Name="LblTransferred" Text="↓ 0,00 ГБ   ↑ 0,00 ГБ" Style="{StaticResource Muted}"/><TextBlock x:Name="LblConnections" Text="0 соединений" Style="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel>
       </StackPanel>
      </Border>
      <TextBlock Text="Трафик: отправлено + получено через Tiho, включая прямые подключения. ГБ = 1 000 000 000 байт." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,12,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="Настройки">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
     <StackPanel>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Сервер" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,14"/>
       <ComboBox x:Name="CmbServers" DisplayMemberPath="Name" SelectionChanged="CmbServers_SelectionChanged"/>
       <WrapPanel Margin="0,12,0,0"><Button Content="Импорт AmneziaWG .conf" Click="BtnImport_Click" Margin="0,0,8,8"/><Button Content="Добавить прокси" Click="BtnAddProxy_Click" Margin="0,0,8,8"/><Button Content="Изменить" Click="BtnEditServer_Click" Margin="0,0,8,8"/><Button Content="Удалить" Click="BtnRemoveServer_Click" Margin="0,0,0,8"/></WrapPanel>
       <TextBlock Text="Для всего трафика и игр используйте клиентский .conf AmneziaWG. HTTP-прокси передаёт только TCP." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel>
       <TextBlock Text="Работа в фоне" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,16"/>
       <CheckBox x:Name="ChkAutoConnect" Content="Подключаться автоматически и восстанавливать связь"/>
       <CheckBox x:Name="ChkStartup" Content="Запускать Tiho при входе в Windows"/>
       <CheckBox x:Name="ChkTray" Content="При закрытии окна оставаться в трее" Margin="0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel>
       <TextBlock Text="Россия напрямую" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,16"/>
       <CheckBox x:Name="ChkRussia" Content="Обходить VPN для российских ресурсов"/>
       <TextBlock Text="Российские домены, сервисы на .com и российские IPv4/IPv6. Они увидят ваш обычный IP провайдера." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
       <DockPanel Margin="0,14,0,0"><Button x:Name="BtnUpdateRules" Content="Обновить списки" Click="BtnUpdateRules_Click" DockPanel.Dock="Right"/><TextBlock x:Name="LblRules" Text="Встроенные списки доступны без загрузки" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
       <TextBlock Text="Дополнительные домены напрямую — по одному на строке" Style="{StaticResource Label}" Margin="0,16,0,7"/>
       <TextBox x:Name="TxtDomains" Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel>
       <TextBlock Text="Программы без VPN" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,8"/>
       <TextBlock Text="Эти программы используют обычное подключение. Для приложения с несколькими .exe добавьте нужные процессы отдельно." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
       <ListBox x:Name="LstExcludedApps" Height="112"/>
       <WrapPanel Margin="0,10,0,0"><Button Content="Выбрать .exe" Click="BtnAddApp_Click" Margin="0,0,8,0"/><Button Content="Убрать из списка" Click="BtnRemoveApp_Click"/></WrapPanel>
      </StackPanel></Border>
      <Button x:Name="BtnSave" Content="Сохранить и применить" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,18,0,12" Click="BtnSave_Click"/>
      <TextBlock x:Name="LblSettingsResult" Foreground="#21856B" TextWrapping="Wrap" Margin="0,0,0,16"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="Логи">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,14"><Button Content="Очистить" Click="BtnClearLogs_Click" DockPanel.Dock="Right"/><CheckBox x:Name="ChkErrors" Content="Только ошибки" Margin="0" VerticalAlignment="Center" Checked="LogFilter_Changed" Unchecked="LogFilter_Changed"/><TextBlock Text="Только текущий запуск · на диск не записываются" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,16,0"/></DockPanel>
     <ListBox x:Name="LstLogs" Grid.Row="1" FontFamily="Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" Padding="3,3"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#525A66"/><Style.Triggers><DataTrigger Binding="{Binding Level}" Value="ERROR"><Setter Property="Foreground" Value="#C14646"/></DataTrigger><DataTrigger Binding="{Binding Level}" Value="DIRECT"><Setter Property="Foreground" Value="#21856B"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </TabItem>
  </TabControl>
 </Grid>
</Window>
