<Window x:Class="Tiho.AddServerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Прокси · Tiho" Width="440" Height="475" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Icon="Assets/app.ico">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Подключение к прокси" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
   <TextBlock Text="Название" Style="{StaticResource Label}"/><TextBox x:Name="TxtName" Margin="0,0,0,12"/>
   <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Адрес сервера" Style="{StaticResource Label}"/><TextBox x:Name="TxtHost"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Порт" Style="{StaticResource Label}"/><TextBox x:Name="TxtPort" Text="3128"/></StackPanel></Grid>
   <TextBlock Text="Протокол" Style="{StaticResource Label}"/><ComboBox x:Name="CmbType" SelectedIndex="0" Margin="0,0,0,12"><ComboBoxItem Content="HTTP"/><ComboBoxItem Content="SOCKS5"/></ComboBox>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Логин, если нужен" Style="{StaticResource Label}"/><TextBox x:Name="TxtUser"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Пароль" Style="{StaticResource Label}"/><PasswordBox x:Name="TxtPass"/></StackPanel></Grid>
  </StackPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" Click="BtnCancel_Click" Margin="0,0,8,0"/><Button Content="Сохранить" Style="{StaticResource Primary}" Click="BtnOk_Click" IsDefault="True"/></StackPanel>
 </Grid>
</Window>
