<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Tiho</AssemblyName>
    <RootNamespace>Tiho</RootNamespace>
    <Product>Tiho</Product>
    <AssemblyTitle>Tiho</AssemblyTitle>
    <Version>2.1.1</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ForceDesignerDpiUnaware>false</ForceDesignerDpiUnaware>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <CoreArchitecture Condition="'$(RuntimeIdentifier)' == 'win-arm64'">arm64</CoreArchitecture>
    <CoreArchitecture Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86</CoreArchitecture>
    <CoreArchitecture Condition="'$(CoreArchitecture)' == ''">x64</CoreArchitecture>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <Content Include="Assets\Rules\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="Core\$(CoreArchitecture)\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo-mark.png" />
  </ItemGroup>
</Project>
